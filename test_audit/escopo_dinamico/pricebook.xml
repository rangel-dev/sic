<?xml version="1.0" encoding="UTF-8"?>
<pricebooks xmlns="http://www.demandware.com/xml/impex/pricebook/2006-10-31">

    <pricebook>
        <header pricebook-id="natura-brazil-list-prices"/>
        <price-tables>
            <!-- Igual à Grade (DE=100) para NÃO gerar divergência de preço -->
            <price-table product-id="NATBRA-9001"><amount quantity="1">100.00</amount></price-table>
        </price-tables>
    </pricebook>
    <pricebook>
        <header pricebook-id="natura-brazil-sale-prices"/>
        <price-tables>
            <!-- Igual à Grade (POR=80) para NÃO gerar divergência de preço -->
            <price-table product-id="NATBRA-9001"><amount quantity="1">80.00</amount></price-table>
        </price-tables>
    </pricebook>

    <!-- Avon: presença obrigatória no Pricebook (regra já existente, não faz
         parte do BRD-003) — valores são irrelevantes pois AVNBRA-9001 nunca
         chega nessa comparação (é interceptado antes pelo Check #13). -->
    <pricebook>
        <header pricebook-id="avon-brazil-list-prices"/>
        <price-tables>
            <price-table product-id="AVNBRA-9001"><amount quantity="1">50.00</amount></price-table>
        </price-tables>
    </pricebook>
    <pricebook>
        <header pricebook-id="avon-brazil-sale-prices"/>
        <price-tables>
            <price-table product-id="AVNBRA-9001"><amount quantity="1">40.00</amount></price-table>
        </price-tables>
    </pricebook>

    <!-- ML: presença obrigatória no Pricebook (regra já existente).
         Usamos o mesmo preço de NATBRA-9001 para não gerar divergência ML. -->
    <pricebook>
        <header pricebook-id="cb-br-list-prices"/>
        <price-tables>
            <price-table product-id="NATBRA-9001"><amount quantity="1">100.00</amount></price-table>
        </price-tables>
    </pricebook>
    <pricebook>
        <header pricebook-id="cb-br-sale-prices"/>
        <price-tables>
            <price-table product-id="NATBRA-9001"><amount quantity="1">80.00</amount></price-table>
        </price-tables>
    </pricebook>

</pricebooks>
